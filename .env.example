# Copy this file to `.env` for local development (`cp .env.example .env`).
# `.env` is git-ignored — never commit a real connection string.
#
# On Vercel you do NOT set this by hand: the "Prisma Postgres" storage
# integration adds DATABASE_URL to the project automatically.
#
# Local development uses a PRIVATE Postgres on this computer, started by
# `npm run dev` (data in .local-postgres/). This value is correct as-is.
# NEVER put the hosted Vercel database address here or in .env.local: outside
# Vercel the app and seed scripts refuse any non-localhost database.
DATABASE_URL="postgresql://nhs_local:nhs_local@localhost:5433/nhsforms_dev"

# Optional: the POOLED connection string from the Prisma Console (host
# pooled.db.prisma.io). Set it in VERCEL only, never locally. If set, the deployed
# app uses it; migrations and the seed still use DATABASE_URL. Optional.
# DATABASE_URL_POOLED=""
