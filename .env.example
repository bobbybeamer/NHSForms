# Copy this file to `.env` (local development only) and fill in the value.
# `.env` is git-ignored — never commit a real connection string.
#
# On Vercel you do NOT set this by hand: the "Prisma Postgres" storage
# integration adds DATABASE_URL to the project automatically.
#
# Local development: paste the DATABASE_URL shown for your Prisma Postgres
# database (Vercel → Storage → your database → ".env.local" tab → Show secret).
# It looks like: postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional: the POOLED connection string from the Prisma Console (host
# pooled.db.prisma.io). If set, the running app uses it; migrations and the seed
# still use DATABASE_URL. Not needed for a low-traffic demo.
# DATABASE_URL_POOLED=""
