generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// SQLite does not support native enums — roles/statuses are stored as plain strings.
// TypeScript enums are defined in src/types/enums.ts for type safety.

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  role           String
  trust          String
  submissions    Submission[]
  decisions      ApprovalStep[] @relation("DecidedBy")
  assignedSteps  ApprovalStep[] @relation("AssignedTo")
  auditEvents    AuditEvent[]
  adminAuditEvents AdminAuditEvent[]
}

model FormType {
  key     String @id
  name    String
  version String
}

model Submission {
  id               String    @id @default(cuid())
  formTypeKey      String
  requesterId      String
  requester        User      @relation(fields: [requesterId], references: [id])
  trust            String
  status           String    @default("DRAFT")
  totalValueIncVat Float     @default(0)
  fieldValues      String    @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  approvalSteps    ApprovalStep[]
  auditEvents      AuditEvent[]
}

model ApprovalStep {
  id           String    @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id])
  sequence     Int
  approverRole String
  status       String    @default("PENDING")
  decisionNote String?
  decidedById  String?
  decidedBy    User?     @relation("DecidedBy", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  assignedToId String?
  assignedTo   User?     @relation("AssignedTo", fields: [assignedToId], references: [id])
}

model AuditEvent {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id])
  actorId      String
  actor        User       @relation(fields: [actorId], references: [id])
  action       String
  detail       String
  createdAt    DateTime   @default(now())
}

// Configurable thresholds editable via the Admin screen.
// Each record is a named numeric rule (e.g. PA23 procurement threshold).
// Routing functions read from here at request time — no hardcoded values in code.
model Threshold {
  key       String   @id   // e.g. "pa23_inc_vat"
  value     Float
  label     String         // human-readable name shown in admin UI
  comment   String         // explains units, legal basis, review cadence
  updatedAt DateTime @updatedAt
}

// System-level audit of admin changes (Build 7). Kept separate from AuditEvent,
// which is submission-scoped: admin changes belong to no submission, and keeping
// AuditEvent.submissionId required preserves the integrity of request histories.
// Values are stored as text so later admin edits (chains, care groups, users)
// can reuse this table without another migration.
model AdminAuditEvent {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String   // e.g. "SETTING_UPDATED"
  target     String   // setting key, e.g. "waiver_band_cfo_upper_inc_vat"
  targetLabel String  // human-readable name at the time of the change
  oldValue   String
  newValue   String
  createdAt  DateTime @default(now())
}
